# Backend Configuration

# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/whiteboard

# Server Port
PORT=4000

# Client Origin (for CORS)
# For local development, this is optional - the server will accept localhost:5173
# For network access from mobile, set this to your computer's IP:
# CLIENT_ORIGIN=http://192.168.0.145:5173
# or use 0.0.0.0 (which is now supported for development)
